# PLACEHOLDER — NOT a real deployment value.
#
# This exists so `npm run build` produces a working bundle. Vite inlines this
# value into the built JS at build time, so a browser loading the deployed app
# would try to call http://localhost:8000 on the *user's own machine*.
#
# CHANGE THIS to the real API origin before any real deployment.
VITE_API_BASE_URL=http://localhost:8000
