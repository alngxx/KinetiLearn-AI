# Placeholder for a local `npm run build` only.
#
# Vite inlines this value into the built JS at build time. The production image
# does not use it: frontend/Dockerfile takes VITE_API_BASE_URL as a build arg,
# which .github/workflows/cd.yml sets from the PUBLIC_URL repository variable,
# and an environment variable overrides this file.
VITE_API_BASE_URL=http://localhost:8000
